# URL del backend (en local, o la URL de Heroku en producción, terminada en /api)
VITE_API_URL=http://localhost:4000/api

# Número de WhatsApp de destino de los pedidos, en formato internacional sin "+" ni espacios
# (ej. Argentina: 549 + código de área sin 0 + número sin 15 -> 5493810000000)
VITE_WHATSAPP_NUMBER=5493810000000
